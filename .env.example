NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Configure in deployment secrets; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Use at least 32 random characters for signed 45-minute Care sessions and limiter keys.
CARE_SESSION_SECRET=

# Public Support BFF. All values are server-only.
MBMC_PUBLIC_API_KEY_ID=
MBMC_PUBLIC_API_SECRET=
MBMC_OPERATIONAL_API_BASE_URL=https://app.mbmc.vn
# Optional override; defaults to https://mbmc.vn.
MBMC_PUBLIC_WEB_ORIGIN=https://mbmc.vn
# Optional comma-separated preview/local browser origins accepted by the same-origin BFF.
MBMC_PUBLIC_ALLOWED_ORIGINS=